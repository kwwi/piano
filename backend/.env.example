# DeepSeek Vision 简谱识别（backend/tool/jianpu_vision_omr.py）
# 复制本文件为 backend/.env 后填写（已 gitignore，不会提交）。
# 也可写在仓库根目录的 .env。进程环境变量优先于文件。

DEEPSEEK_API_KEY=

# 可选：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_VISION_DETAIL=high
# DEEPSEEK_TIMEOUT=180

# --- Hugging Face（MuScriptor 权重下载，必填才能拉 gated 模型）---
# 1) 在 https://huggingface.co/MuScriptor/muscriptor-medium 接受 CC BY-NC
# 2) 创建 token：https://huggingface.co/settings/tokens
HF_TOKEN=

# --- 音频转录（默认 MuScriptor 多乐器）---
# DEFAULT_MODEL=muscriptor
# MUSCRIPTOR_SIZE=medium           # small | medium | large（CPU 建议 small）
# MUSCRIPTOR_DEVICE=auto           # auto | cpu | cuda | mps
# MUSCRIPTOR_QUANTIZE=0              # 默认关：M2S 需要未量化的演奏 MIDI

# --- MIDI2ScoreTransformer（必需：MIDI → 五线谱 MusicXML）---
# 先运行 m2s_worker/setup_m2s.sh；默认路径都在 backend/.m2s/ 下
# M2S_PYTHON=backend/.m2s/venv/bin/python   # Python 3.11 独立 venv
# M2S_ROOT=backend/.m2s/MIDI2ScoreTransformer
# M2S_CKPT=backend/.m2s/MIDI2ScoreTF.ckpt
# M2S_DEVICE=auto                  # auto(=cuda，否则 cpu) | cuda | mps | cpu；Apple 芯片上 cpu 比 mps 快 10 倍以上
# M2S_TIMEOUT=900                  # 单次请求超时（秒），CPU 整曲较慢
# M2S_STARTUP_TIMEOUT=300          # worker 加载模型超时（秒）
# SCORE_MODE_DEFAULT=per_track     # per_track | piano_only | reduce_all

# --- MT3 via mt3-infer（备选）---
# DEFAULT_MODEL=mt3
# MT3_INFER_MODEL=mt3_pytorch   # 或 mr_mt3 / yourmt3
# MT3_DEVICE=auto               # auto | cpu | cuda
# MT3_CHECKPOINT=               # 可选：本地权重路径；空则首次自动下载
# MT3_SAMPLE_RATE=16000

# --- 长音频分段转录（先切段再转谱，再合并 MIDI）---
# SPLIT_AUDIO_DEFAULT=false
# SPLIT_SECONDS_DEFAULT=30
# SPLIT_OVERLAP_SECONDS=1.0

# --- torchcrepe（model=crepe：人声主旋律）---
# CREPE_MODEL=tiny                 # tiny (default, fast) | full (slow on CPU)
# CREPE_DEVICE=auto                # auto | cpu | cuda
# CREPE_CHUNK_SECONDS=20
# CREPE_TORCH_THREADS=2            # keep low so CREPE does not pin every core
# CREPE_PERIODICITY=0.35
# CREPE_MIN_DUR=0.06
# CREPE_HARMONY_BP=0               # 1 = also run Basic Pitch on mix for chords
# CREPE_HARMONY_MAX_SECONDS=90

# --- 钢琴谱编配（GET /jobs/{id}/midi|musicxml?arrange=piano）---
# PIANO_ARRANGER_BACKEND=auto      # auto | texture | structured | rule
# PIANO_ARRANGER_STYLE=pop         # pop | ballad | drive
# PIANO_ARRANGER_AUTO_CHORDS=1     # 未勾选和弦时自动估计
# PIANO_ARRANGER_ROOT=             # 可选：Structured-Arrangement-Code 根目录
