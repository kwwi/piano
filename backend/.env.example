# DeepSeek Vision 简谱识别（backend/tool/jianpu_vision_omr.py）
# 复制为仓库根目录或 backend/ 下的 `.env` 后填写。
# 也可不建文件，直接 export DEEPSEEK_API_KEY=...

DEEPSEEK_API_KEY=sk-your-key-here

# 可选：
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_VISION_DETAIL=high
# DEEPSEEK_TIMEOUT=180
